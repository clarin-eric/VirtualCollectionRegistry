    <profiles>
        <profile>
            <id>development</id>
            <properties>
                <log4j.appender>FILE</log4j.appender>               
                <war.webxml>src/main/resources/profiles/dev/web.xml</war.webxml>
                <war.contextxml>src/main/resources/profiles/dev/context.xml</war.contextxml>
